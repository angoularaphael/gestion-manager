# Vercel — gestion-manager
# Copier dans Vercel → Settings → Environment Variables (Production + Preview)
# ou : vercel env pull .env.local

# ── Envoi test campagnes ───────────────────────────────────────────────────────
CAMPAIGN_TEST_EMAIL=giffareno237@gmail.com
NEXT_PUBLIC_CAMPAIGN_TEST_EMAIL=giffareno237@gmail.com
CAMPAIGN_TEST_PHONE=237693646080

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://manager.boxingcenter.fr
NEXT_PUBLIC_BOXING_CENTER_SITE=https://boxingcenter.fr/
# Images email : logo integre (cid). Hero optionnel.
# NEXT_PUBLIC_EMAIL_HERO_URL=https://gestion-manager.vercel.app/logo.png
# NEXT_PUBLIC_LOGO_URL=https://gestion-manager.vercel.app/logo.png

# ── Bot Bothosting (comme NYC Cookies) ────────────────────────────────────────
# Bot legacy (Minimes — mêmes URLs que compta-boxing)
NEXT_PUBLIC_WHATSAPP_BOT_URL=http://prem-eu4.bot-hosting.net:20125
# Campagne clients — 3 serveurs compta-boxing (12 msg / 30 min, ~2m30 entre envois)
# ⚠️ Le bot Minimes (20125) est AUSSI utilisé par phone-bot (bot téléphonique
#    09 39 03 67 48) pour envoyer les messages WhatsApp aux appelants.
#    Ne pas changer son port/URL sans mettre à jour phone-bot/.env (WHATSAPP_BOT_URL).
WHATSAPP_BOT_URL_MINIMES=http://prem-eu4.bot-hosting.net:20125
WHATSAPP_BOT_URL_ST_CYPRIEN=http://prem-eu2.bot-hosting.net:20405
WHATSAPP_BOT_URL_RAMONVILLE=http://prem-eu4.bot-hosting.net:21357
# Alias compta-boxing (lus en secours si WHATSAPP_BOT_URL_* vide)
# BOT_URL_MINIMES=http://prem-eu4.bot-hosting.net:20125
# BOT_URL_ST_CYPRIEN=http://prem-eu2.bot-hosting.net:20405
# BOT_URL_RAMONVILLE=http://prem-eu4.bot-hosting.net:21357
CAMPAIGN_WA_PER_BOT_WAVE=12
CAMPAIGN_WA_WINDOW_MINUTES=30

# ── Supabase ──────────────────────────────────────────────────────────────────
# Même projet que BOXPLUS (SUPABASE_URL) — portet_clients + tunnel_leads + boxplus_orders
NEXT_PUBLIC_SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Sécurité — même SITE_API_SECRET que le bot Bothosting ─────────────────────
SITE_API_SECRET=
SESSION_SECRET=

# ── Super administrateur (env uniquement) ─────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email — fournisseur (resend | ses | mailjet | brevo | auto) ───────────────
# Campagnes : Resend (simple, 3 000/mois gratuits). Pas AWS sandbox, pas Mailjet.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
SES_SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_SENDER_EMAIL=no-reply@mail.boxingcenter.fr
SES_SENDER_NAME=Boxing Center
SES_REGION=eu-west-3
# ── 6 SIM campagne (gestion-manager-1 … 6) — partagés Balma + offres promo ───
WHATSAPP_CAMPAIGN_BOT_URL_1=http://prem-eu4.bot-hosting.net:21357
WHATSAPP_CAMPAIGN_BOT_URL_2=http://prem-eu2.bot-hosting.net:20405
WHATSAPP_CAMPAIGN_BOT_URL_3=http://prem-eu4.bot-hosting.net:20695
WHATSAPP_CAMPAIGN_BOT_URL_4=http://prem-eu2.bot-hosting.net:21774
WHATSAPP_CAMPAIGN_BOT_URL_5=http://prem-eu2.bot-hosting.net:21871
WHATSAPP_CAMPAIGN_BOT_URL_6=http://prem-eu2.bot-hosting.net:21724
CAMPAIGN_WA_PER_BOT_WAVE=12
CAMPAIGN_WA_WINDOW_MINUTES=30
CAMPAIGN_USE_CLUB_BOTS=0
# Défaut cron si campaign_settings.campaign absent. Deux campagnes : balma | offres
CAMPAIGN_KIND=balma
RESEND_DAILY_LIMIT=1600
RESEND_HOURLY_LIMIT=80

# ── Email — fournisseur historique (mailjet | brevo | auto) ────────────────────
# Campagnes clients : TOUJOURS mailjet (Brevo/suzinabot banni pour l'envoi massif)
# EMAIL_PROVIDER=mailjet

# ── Cron campagne horaire (Vercel) ────────────────────────────────────────────
# Générer une chaîne aléatoire — Vercel l'envoie en Authorization: Bearer …
CRON_SECRET=

# ── Mailjet — 3 comptes ───────────────────────────────────────────────────────
# Plafond campagne : 200 emails/heure (sous la limite 500/h observée)
MAILJET_HOURLY_LIMIT=200
MAILJET_WAVE_LIMIT=200
# Chaque compte = abonnement Mailjet séparé. API : Account Settings → REST API
# Valider boxing-center-portet.fr + no-reply@boxing-center-portet.fr sur chaque compte.
MAILJET_1_API_KEY=
MAILJET_1_SECRET_KEY=
MAILJET_1_SENDER_EMAIL=no-reply@boxing-center-portet.fr
MAILJET_1_SENDER_NAME=Boxing Center
MAILJET_1_LABEL=Campagne 1 — no-reply

MAILJET_2_API_KEY=
MAILJET_2_SECRET_KEY=
MAILJET_2_SENDER_EMAIL=no-reply@boxing-center-portet.fr
MAILJET_2_SENDER_NAME=Boxing Center
MAILJET_2_LABEL=Campagne 2 — no-reply

MAILJET_3_API_KEY=
MAILJET_3_SECRET_KEY=
MAILJET_3_SENDER_EMAIL=no-reply@boxing-center-portet.fr
MAILJET_3_SENDER_NAME=Boxing Center
MAILJET_3_LABEL=Campagne 3 — no-reply

MAILJET_REPLY_TO=boxingcenter31@gmail.com
# Routage automatique par type d'email (numéro de compte 1, 2 ou 3)
MAILJET_PURPOSE_CAMPAIGN=1
MAILJET_PURPOSE_NOTIFY=1
MAILJET_PURPOSE_CREDENTIALS=2

# ── Brevo — repli si EMAIL_PROVIDER=brevo ou auto sans Mailjet ─────────────────
# Clé v3 : xkeysib-… — Brevo → SMTP & API → Clés API
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=suzinabot@11426075.brevosend.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcenter31@gmail.com

# Adresse légale affichée en pied d'email (obligatoire campagnes FR)
NEXT_PUBLIC_LEGAL_ADDRESS=Boxing Center — clubs de boxe à Toulouse et agglomération, France

# ── Emails (affichage) ────────────────────────────────────────────────────────
NEXT_PUBLIC_BREVO_SENDER_EMAIL=suzinabot@11426075.brevosend.com
NEXT_PUBLIC_CONTACT_EMAIL=boxingcenter31@gmail.com
NEXT_PUBLIC_RECEPTION_EMAIL=boxingcenter31@gmail.com

# ── Tunnels marketing ─────────────────────────────────────────────────────────
TUNNEL_CORS_ORIGINS=https://boxingcenter.fr,https://www.boxingcenter.fr
# Alias historique (lu si TUNNEL_CORS_ORIGINS vide) :
# OFFRE_ETE_CORS_ORIGINS=https://boxingcenter.fr,https://www.boxingcenter.fr
# OFFRE_29_BOUTIQUE_URL=https://boutique.boxingcenter.fr/...

# ── Chatbot Portet ────────────────────────────────────────────────────────────
CHATBOT_ALLOW_RESET=true
